  <capability standardID="ivo://ivoa.net/std/SLAP#lines-2.0" xsi:type="slap:SimpleLineAccess">
    <interface xsi:type="vs:ParamHTTP">
      <accessURL use="base">http://dc.g-vo.org/toss/q/q/lines?</accessURL>
      <mirrorURL>https://dc.g-vo.org/toss/q/q/lines?</mirrorURL>
      <queryType>GET</queryType>
      <resultType>application/x-votable+xml</resultType>
      <param std="true">
        <name>WAVELENGTH</name>
        <description>The wavelength of the transition</description>
        <unit>m</unit>
        <stats>
          <min>1.07005e-08</min>
          <percentile03>3.164765e-08</percentile03>
          <median>1.51973e-07</median>
          <percentile97>2.3999556499999968e-06</percentile97>
          <max>4.9930139000000005e-05</max>
          <fillFactor>1.0</fillFactor>
        </stats>
        <dataType arraysize="2" xsi:type="vs:SimpleDataType">real</dataType>
      </param>
      <param std="true">
        <name>SPECIES_MASS</name>
        <description>Mass of the atom or molecule</description>
        <unit>u</unit>
        <stats>
          <min>63.546</min>
          <percentile03>72.62999725341797</percentile03>
          <median>97.0</median>
          <percentile97>97.0</percentile97>
          <max>137.33</max>
          <fillFactor>1.0</fillFactor>
        </stats>
        <dataType arraysize="2" xsi:type="vs:SimpleDataType">real</dataType>
      </param>
      <param std="true">
        <name>ION_CHARGE</name>
        <description>Charge of the atom or molecule</description>
        <stats>
          <min>-6</min>
          <percentile03>-5.0</percentile03>
          <median>-3.0</median>
          <percentile97>-3.0</percentile97>
          <max>-3</max>
          <fillFactor>1.0</fillFactor>
        </stats>
        <dataType arraysize="2" xsi:type="vs:SimpleDataType">real</dataType>
      </param>
      <param std="true">
        <name>LOWER_LEVEL_ENERGY</name>
        <description>Lower level of the transition</description>
        <unit>J</unit>
        <stats>
          <min>0.0</min>
          <percentile03>8.525229685126064e-19</percentile03>
          <median>3.844646769760322e-18</median>
          <percentile97>5.689141205957388e-18</percentile97>
          <max>1.2494287558919616e-17</max>
          <fillFactor>1.0</fillFactor>
        </stats>
        <dataType arraysize="2" xsi:type="vs:SimpleDataType">real</dataType>
      </param>
      <param std="true">
        <name>UPPER_LEVEL_ENERGY</name>
        <description>Lower level of the transition</description>
        <unit>J</unit>
        <stats>
          <min>6.094415889732886e-20</min>
          <percentile03>2.9456608326490024e-18</percentile03>
          <median>5.016888198981048e-18</median>
          <percentile97>9.847825201274385e-18</percentile97>
          <max>1.856405165556531e-17</max>
          <fillFactor>1.0</fillFactor>
        </stats>
        <dataType arraysize="2" xsi:type="vs:SimpleDataType">real</dataType>
      </param>
      <param std="true">
        <name>EINSTEINA</name>
        <description>Einstein A of the transition</description>
        <unit>s**-1</unit>
        <stats>
          <min>0.0301</min>
          <percentile03>180.0</percentile03>
          <median>940000.0</median>
          <percentile97>1000000000.0</percentile97>
          <max>5300000000000.0</max>
          <fillFactor>1.0</fillFactor>
        </stats>
        <dataType arraysize="2" xsi:type="vs:SimpleDataType">real</dataType>
      </param>
      <param std="true">
        <name>INCHIKEY</name>
        <description>The InChI-Key of the species doing the transition. Note that this is the only interoperable way to constrain species of molecules, as there is no common syntax for species_name. Use SLAP2 species endpoints to obtain InChI-Keys for species you are interested in.</description>
        <ucd>phys.atmol.element</ucd>
        <dataType arraysize="*" xsi:type="vs:SimpleDataType">char</dataType>
      </param>
      <param std="true">
        <name>SPECIES</name>
        <description>A name for the species doing the transition. This can be an atom symbol; for molecules, use this service's species endpoint to figure out the local syntax or, better, use the interoperable InChI-Key.</description>
        <ucd>phys.atmol.element</ucd>
        <stats>
          <option freq="0.0218029">Cu</option>
          <option freq="0.0024488103">Zn</option>
          <option freq="0.006048422">Ga</option>
          <option freq="0.0027647165">Ge</option>
          <option freq="0.00033309837">Se</option>
          <option freq="0.0032772582">Kr</option>
