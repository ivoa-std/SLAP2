  <tableset>
    <schema>
      <name>toss</name>
      <title>TOSS &#x2013; T&#xFC;bingen Oscillator Strengths Service</title>
      <description> This service provides oscillator strengths and transition
probabilities. Mainly based on experimental energy levels, these were
calculated with the pseudo-relativistic Hartree-Fock method including
core-polarization corrections.</description>
      <table>
        <name>toss.data</name>
        <description> This table contains line data computed using a pseudo-relativistic
Hartree-Fock method including core-polarization corrections.</description>
        <nrows>930656</nrows>
        <column>
          <name>vacuum_wavelength</name>
          <description>Vacuum wavelength of the transition</description>
          <unit>m</unit>
          <ucd>em.wl</ucd>
          <stats>
            <min>1.07005e-08</min>
            <percentile03>3.16477e-08</percentile03>
            <median>1.51973e-07</median>
            <percentile97>2.39996e-06</percentile97>
            <max>4.99301e-05</max>
            <fillFactor>1</fillFactor>
          </stats>
          <dataType xsi:type="vs:VOTableType">double</dataType>
          <flag>indexed</flag>
        </column>
        <column>
          <name>vacuum_wavelength_error</name>
          <description>Total error in vacuum_wavelength</description>
          <unit>m</unit>
          <ucd>stat.error;em.wl</ucd>
          <stats>
            <fillFactor>0</fillFactor>
          </stats>
          <dataType xsi:type="vs:VOTableType">double</dataType>
          <flag>nullable</flag>
        </column>
        <column>
          <name>line_title</name>
          <description>Human-readable line designation.</description>
          <ucd>meta.title</ucd>
          <dataType arraysize="*" xsi:type="vs:VOTableType">char</dataType>
        </column>
        <column>
          <name>species_name</name>
          <description>A human-readable designation of the atom or molecule doing the transition.</description>
          <ucd>phys.atmol.element</ucd>
          <stats>
            <option freq="0.0218029">Cu</option>
            <option freq="0.0024488103">Zn</option>
            <option freq="0.006048422">Ga</option>
            <option freq="0.0027647165">Ge</option>
            <option freq="0.00033309837">Se</option>
            <option freq="0.0032772582">Kr</option>
            <option freq="0.010439948">Sr</option>
            <option freq="0.0038994">Zr</option>
            <option freq="0.011630506">Mo</option>
            <option freq="0.93250996">Tc</option>
            <option freq="0.00019126294">Te</option>
            <option freq="0.00021167865">I</option>
            <option freq="0.0026841282">Xe</option>
            <option freq="0.0017578998">Ba</option>
          </stats>
          <dataType arraysize="*" xsi:type="vs:VOTableType">char</dataType>
        </column>
        <column>
          <name>inchikey</name>
          <description>The InChi key (hash) generated from inchi.</description>
          <ucd>meta.id;phys.atmol</ucd>
          <dataType arraysize="*" xsi:type="vs:VOTableType">char</dataType>
        </column>
        <column>
          <name>inchi</name>
          <description>International Chemical Identifier InChI.</description>
          <ucd>meta.id;phys.atmol;meta.main</ucd>
          <dataType arraysize="*" xsi:type="vs:VOTableType">char</dataType>
        </column>
        <column>
          <name>ion_charge</name>
          <description>Total charge (ionisation level) of the emitting particle.</description>
          <ucd>phys.electCharge</ucd>
          <stats>
            <min>-6</min>
            <percentile03>-5.0</percentile03>
            <median>-3.0</median>
            <percentile97>-3.0</percentile97>
            <max>-3</max>
            <fillFactor>1.0</fillFactor>
          </stats>
          <dataType xsi:type="vs:VOTableType">int</dataType>
          <flag>indexed</flag>
        </column>
        <column>
          <name>species_mass</name>
          <description>Assumed mass of the atom; this is the mass given by NIST, https://www.nist.gov/pml/periodic-table-elements</description>
          <unit>u</unit>
          <ucd>phys.atmol.weight</ucd>
          <stats>
            <min>63.546</min>
            <percentile03>72.63</percentile03>
            <median>97</median>
            <percentile97>97</percentile97>
            <max>137.33</max>
            <fillFactor>1</fillFactor>
          </stats>
          <dataType xsi:type="vs:VOTableType">float</dataType>
          <flag>indexed</flag>
          <flag>nullable</flag>
        </column>
        <column>
          <name>lower_level_description</name>
          <description>A human-readable designation of the lower (less total energy) state.</description>
          <unit>J</unit>
          <ucd>meta.title;phys.atmol.level</ucd>
          <dataType arraysize="*" xsi:type="vs:VOTableType">char</dataType>
          <flag>nullable</flag>
        </column>
        <column>
          <name>upper_level_description</name>
          <description>A human-readable designation of the upper (more total energy) state.</description>
          <unit>J</unit>
          <ucd>meta.title;phys.atmol.level</ucd>
          <dataType arraysize="*" xsi:type="vs:VOTableType">char</dataType>
          <flag>nullable</flag>
        </column>
        <column>
          <name>einstein_a</name>
