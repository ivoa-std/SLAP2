  <content>
    <subject>atomic-physics</subject>
    <subject>spectral-line-identification</subject>
    <description> This service provides oscillator strengths and transition
probabilities. Mainly based on experimental energy levels, these were
calculated with the pseudo-relativistic Hartree-Fock method including
core-polarization corrections.</description>
    <source format="bibcode">2016A&amp;A...587A..39R</source>
    <referenceURL>http://dc.g-vo.org/toss/q/q/info</referenceURL>
    <relationship>
      <relationshipType>IsServedBy</relationshipType>
      <relatedResource ivo-id="ivo://org.gavo.dc/tap">GAVO Data Center TAP service</relatedResource>
    </relationship>
  </content>
